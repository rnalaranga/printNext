# =============================================================================
# RR Secure Print — Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment shell.
# =============================================================================

# Server HTTP Port (Default 8080, can be set to 8000 for Toshiba MFP testing)
PORT=8080

# Active Spring Profile (dev = Embedded DB + Spool Simulation; postgres = Production PostgreSQL)
ACTIVE_PROFILE=dev

# PostgreSQL Database Configuration (Required only when ACTIVE_PROFILE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rr_secure_print
DB_USER=postgres
DB_PASSWORD=postgres

# Secure Spool Storage Directory (Filesystem path outside web root)
SPOOL_STORAGE_DIR=spool_data

# Physical Printer Safety Switch
# Set to true for development/simulation (NEVER transmits bytes to Port 9100)
# Set to false ONLY when ready to transmit live PCL6/PostScript bytes to the Toshiba MFP
PRINTER_SIMULATION_MODE=true

# Active Directory / LDAPS Configuration (Optional enterprise identity source)
AD_ENABLED=false
AD_LDAP_URL=ldaps://dc01.rrconstruction.local:636
AD_DOMAIN=rrconstruction.local
AD_BASE_DN=DC=rrconstruction,DC=local
